{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "nodenext",
    "target": "ES2018",
    "allowJs": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "moduleResolution": "nodenext",
    "importHelpers": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "DOM",
      "ES2018",
      "ES2019",
      "ES2020",
      "ES2021"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
